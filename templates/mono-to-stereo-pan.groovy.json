  },
  "nodes": [
    {
      "id": "note-overview",
      "type": "Note",
      "pos": { "x": 0, "y": -60 },
      "widgets": {
        "text": "Mono → stereo with the layout-agnostic Pan node (−1 left … +1 right). Load → ChannelConvert mono → Pan (stereo) with a ControlCurve sweep → Preview. Pan also targets 5.1 / 7.1 / 7.1.4 beds the same way."
      }
    },
    {
      "id": "n1",
      "type": "LoadAudio",
      "pos": { "x": 0, "y": 120 },
      "widgets": { "path": "assets/samples/podcast_denoise_demo.wav" }
    },
    {
      "id": "n2",
      "type": "ChannelConvert",
      "pos": { "x": 260, "y": 120 },
      "widgets": { "layout": "mono" }
    },
    {
      "id": "n3",
      "type": "ControlCurve",
      "pos": { "x": 260, "y": 320 },
      "widgets": {
        "start_value": -1.0,
        "end_value": 1.0,
        "frame_count": 48000,
        "sample_rate": 48000,
        "points": "[{\"t\":0,\"v\":-1},{\"t\":0.5,\"v\":1},{\"t\":1,\"v\":-0.25}]"
      }
    },
    {
      "id": "n4",
      "type": "Pan",
      "pos": { "x": 520, "y": 120 },
      "widgets": { "pan": 0.0, "output_layout": "stereo" }
    },
    {
      "id": "n5",
      "type": "Preview",
      "pos": { "x": 780, "y": 120 },
      "widgets": {}
    }
