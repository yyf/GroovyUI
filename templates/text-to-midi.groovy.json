  "nodes": [
    {
      "id": "note-overview",
      "type": "Note",
      "pos": { "x": 0, "y": 360.0 },
      "widgets": {
        "text": "Text → MIDI (+ DSP audio)\nPrompt → GenerateMidi → PreviewMidi → SaveMidi\nGenerateMidi → SynthMidi (pretty_midi) → Normalize → Preview/Save\nGenerateMidi.log → SaveGenerateLog\nReal MIDI: midi-llm (Mac MPS) · path demo: midi-gen\nPlay = cached audition, not live inference"
      }
    },
    {
      "id": "n-midi-prompt",
      "type": "Prompt",
      "pos": { "x": 0, "y": 40.0 },
      "widgets": {
        "text": "30-second experimental IDM piano piece with Bohlen-Pierce microtonality, glitchy repetitions, fragmented arpeggios, irregular rhythms, and angular melodies. Notes 0-127 only.",
        "language": "en"
      }
    },
    {
      "id": "n-gen-midi",
      "type": "GenerateMidi",
      "pos": { "x": 280, "y": 40.0 },
      "widgets": {
        "model": "midi-llm",
        "prompt": "30-second experimental IDM piano piece with Bohlen-Pierce microtonality, glitchy repetitions, fragmented arpeggios, irregular rhythms, and angular melodies. Notes 0-127 only.",
        "max_tokens": 1024,
        "temperature": 1.0,
        "top_p": 0.98,
        "duration": 30.0,
        "seed": 42
      }
    },
    {
      "id": "n-preview-midi",
      "type": "PreviewMidi",
      "pos": { "x": 560, "y": 40.0 },
      "widgets": {}
    },
    {
      "id": "n-save-midi",
      "type": "SaveMidi",
      "pos": { "x": 840, "y": 40.0 },
      "widgets": {
        "path": "exports",
        "filename": "text-to-midi.mid"
      }
    },
    {
      "id": "n-midi-log",
      "type": "SaveGenerateLog",
      "pos": { "x": 560, "y": 180.0 },
