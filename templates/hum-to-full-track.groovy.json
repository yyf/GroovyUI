  "metadata": {
    "title": "Hum / Melody -> Full Track",
    "author": "groovy",
    "description": "Use Audio->MIDI (basic-pitch) on humming/melody audio, then MusicGen Melody to render a full track. Preview and save the cached render.",
    "tags": [
      "musicgen",
      "melody",
      "basic-pitch",
      "midi",
      "regenerate",
      "hero"
    ],
    "created_at": "2026-07-26T00:00:00Z",
    "modified_at": "2026-07-26T00:00:00Z"
  },
  "nodes": [
    {
      "id": "note-sample-accuracy",
      "type": "Note",
      "pos": {
        "x": 0,
        "y": 0
      },
      "widgets": {
        "text": "Sample-accurate offline render: Play auditions cached PCM at discrete frames (not a live DAW clock). Generative / AI hops in this graph are nondeterministic \u2014 length and timbre may vary by seed and hardware."
      }
    },
    {
      "id": "n1",
      "type": "LoadAudio",
      "pos": {
        "x": 0,
        "y": 120.0
      },
      "widgets": {
        "path": "assets/samples/male-1.wav"
      }
    },
    {
      "id": "n2",
      "type": "AudioToMIDI",
      "pos": {
        "x": 246,
        "y": 120.0
      },
      "widgets": {
        "model": "basic-pitch"
      }
    },
    {
      "id": "n3",
      "type": "Prompt",
      "pos": {
        "x": 0,
        "y": 244.0
      },
      "widgets": {
        "text": "translate this humming melody into a full pop track with drums, bass, and a catchy lead",
        "language": "en"
      }
    },
    {
      "id": "n4",
      "type": "MIDIToAudio",
      "pos": {
        "x": 482,
        "y": 120.0
      },
      "widgets": {
        "model": "musicgen-melody-small",
        "prompt": "full track from humming melody"
      }
    },
    {
      "id": "n5",
      "type": "Normalize",
      "pos": {
        "x": 718,
        "y": 120.0
      },
      "widgets": {
        "mode": "lufs",
        "target_lufs": -16.0
      }
    },
    {
      "id": "n6",
      "type": "Preview",
      "pos": {
        "x": 954,
        "y": 120.0
      },
      "widgets": {}
    },
    {
      "id": "n7",
      "type": "SaveAudio",
      "pos": {
        "x": 954,
        "y": 244.0
      },
      "widgets": {
        "path": "exports",
        "filename": "hum-to-full-track.wav",
        "format": "wav"
      }
    }
  ],
