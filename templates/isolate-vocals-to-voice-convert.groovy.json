  "metadata": {
    "title": "Isolate to convert",
    "author": "groovy",
    "description": "Two-step vocal workflow as a patch-bay chain: Demucs stem split (vocals) -> DeepFilterNet denoise -> RVC voice convert. Preview and save the converted take.",
    "tags": [
      "ai",
      "vocals",
      "separation",
      "denoise",
      "voice-convert",
      "rvc"
    ],
    "created_at": "2026-07-26T00:00:00Z",
    "modified_at": "2026-07-26T00:00:00Z"
  },
  "nodes": [
    {
      "id": "n1",
      "type": "LoadAudio",
      "pos": {
        "x": 0,
        "y": 80
      },
      "widgets": {
        "path": "assets/samples/Knockout_41k_mono.wav"
      }
    },
    {
      "id": "n2",
      "type": "SeparateStems",
      "pos": {
        "x": 260,
        "y": 80
      },
      "widgets": {
        "model": "demucs-v4",
        "shifts": 1,
        "overlap": 0.25,
        "segment": 0,
        "split": true
      }
    },
    {
      "id": "n3",
      "type": "Denoise",
      "pos": {
        "x": 520,
        "y": 80
      },
      "widgets": {
        "model": "deepfilternet-v3",
        "strength": 1.0
      }
    },
    {
      "id": "n4",
      "type": "VoiceConvert",
      "pos": {
        "x": 780,
        "y": 80
      },
      "widgets": {
        "model": "rvc-v2-base"
      }
    },
    {
      "id": "n5",
      "type": "Normalize",
      "pos": {
        "x": 1010,
        "y": 80
      },
      "widgets": {
        "mode": "lufs",
        "target_lufs": -16.0
      }
    },
    {
      "id": "n6",
      "type": "Preview",
      "pos": {
        "x": 1240,
        "y": 80
      },
      "widgets": {}
    },
    {
      "id": "n7",
      "type": "SaveAudio",
      "pos": {
        "x": 1240,
        "y": 200
      },
      "widgets": {
        "path": "exports",
        "filename": "voice-converted-vocals.wav",
        "format": "wav",
        "bit_depth": "16"
      }
    }
  ],
