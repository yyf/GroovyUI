      "type": "Note",
      "pos": { "x": 0, "y": 460.0 },
      "widgets": {
        "text": "I2V: Fort-Zeelandia.png + prompt (ltx-2.3-q4)\nImage anchors frame 0; prompt steers style & motion (image_strength 0–1)\nnum_steps: distilled Real is fixed ~8 steps; more steps won’t apply on this model\n512×512 square vs landscape still = crop/letterbox — expect composition shift"
      }
    },
    {
      "id": "n0",
      "type": "Prompt",
      "pos": { "x": 0, "y": 40.0 },
      "widgets": {
        "text": "Regenerate the reference image using Pointillism technique for visual aesthetics and ambient city soundscape for sound design",
        "language": "en"
      }
    },
    {
      "id": "n-img",
      "type": "LoadImage",
      "pos": { "x": 0, "y": 220.0 },
      "widgets": {
        "path": "assets/samples/Fort-Zeelandia.png"
      }
    },
    {
      "id": "n1",
      "type": "GenerateVideo",
      "pos": { "x": 280, "y": 40.0 },
      "widgets": {
        "model": "ltx-2.3-q4",
        "prompt": "Regenerate the reference image using Pointillism technique for visual aesthetics and ambient city soundscape for sound design",
        "negative_prompt": "",
        "duration": 2.0,
        "width": 512,
        "height": 512,
        "num_steps": 8,
        "image_strength": 0.3,
        "seed": 42
      }
    },
