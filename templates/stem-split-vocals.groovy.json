  },
  "nodes": [
    {
      "id": "n1",
      "type": "LoadAudio",
      "pos": { "x": 0, "y": 80 },
      "widgets": {
        "path": "assets/samples/Patrick Talbot - Set Me Free.stem.mp4",
        "audio_stream": 0
      }
    },
    {
      "id": "n2",
      "type": "SeparateStems",
      "pos": { "x": 260, "y": 80 },
      "widgets": {
        "model": "demucs-v4",
        "shifts": 1,
        "overlap": 0.25,
        "segment": 0,
        "split": true
      }
    },
    { "id": "n3", "type": "Preview", "pos": { "x": 560, "y": -40 }, "widgets": {} },
